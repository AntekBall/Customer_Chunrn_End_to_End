# Portable serving (preferred for deployment). Use a trusted local bundle only.
# Export: uv run python -m src.models.serving_bundle --output artifacts\serving_v1
# Paths are relative to the process working directory, unless absolute.
# Set these in the process environment; the app does not load .env automatically.
CHURN_BUNDLE_DIRECTORY=artifacts\serving_v1
CHURN_API_URL=http://127.0.0.1:8000

# Do not set CHURN_TRACKING_DIRECTORY, CHURN_PORTFOLIO_DIRECTORY or
# CHURN_FINAL_TEST_RUN_ID together with CHURN_BUNDLE_DIRECTORY.
# Deploy the application source + uv.lock + bundle; MLflow DB/raw data are not
# required. Install locked dependencies with uv sync --locked.
# Package versions are recorded for audit, not a substitute for uv.lock.
# Bundles include customer features. Do not commit full/private bundles or accept
# uploaded ones. The generated synthetic public demo below is the only exception.

# Public synthetic demo only (separate from the full local bundle):
# uv run python -m src.data.demo --source artifacts\serving_v1 --output deploy\demo_bundle
# $env:CHURN_BUNDLE_DIRECTORY = "deploy\demo_bundle"
# uv run --locked python -m src.web
# PORT defaults to 8000 locally and is supplied by Render in deployment.
# Set PORT to an unused port (for example 8051) if the local API is still running.
# render.yaml selects the Free plan. No paid database or persistent disk is used.
# Only the explicitly generated synthetic demo is intended for publication.
# Keep .gitattributes with the bundle: Git line-ending conversion would break
# byte-level checksums. Do not normalize or manually edit generated bundle files.
# Its schema-v2 manifest records the source snapshot hash, sampling seed and
# partition counts. Thresholds remain fitted on the original full training set.
# All displayed totals and campaign selection use only the demo population.
# One process shares Dash and FastAPI imports; no MLflow package is needed.
# Render installs only the serving dependency group in its own environment.
# Avoid --only-group serving in the normal local environment: it removes
# training/dev dependencies there. Use uv sync to restore them if needed.
# Public requests are limited to 2 MiB and server concurrency is bounded.
# This is an anonymous hobby demo, not an authenticated production service.

# Local Docker Desktop (Linux containers), run from the project root:
# docker compose up --build --wait
# Dashboard: http://localhost:8050 ; API docs: http://localhost:8000/docs
# Stop: docker compose down
# The full bundle must already exist; Docker never trains or exports it.
# Only the API mounts the bundle, read-only. No datasets/MLflow/bundles enter
# the image. Both host ports bind to loopback, not the public network.
# Compose reads .env for these optional substitutions (not needed by default):
# CHURN_LOCAL_BUNDLE=./artifacts/serving_v1
# CHURN_API_PORT=8000
# CHURN_DASH_PORT=8050
# Change ports above if your native local services already occupy them.
# Docker Desktop should have at least 4 GiB available for the full portfolio.
# Inspect health/logs: docker compose ps ; docker compose logs api dashboard
# Inspect Linux memory: docker stats --no-stream